# ── Required ──────────────────────────────────────────────────────────────────
# Automatically provided by Railway when you add a Postgres plugin
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-secret

# Set this to your Railway frontend service public URL after deploying
FRONTEND_ORIGIN=https://your-frontend.up.railway.app

# ── Optional: Email (SendGrid) ─────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
SENDGRID_TEMPLATE_RFQ_SUBMITTED=
SENDGRID_TEMPLATE_RFQ_QUOTED=
SENDGRID_TEMPLATE_ORDER_CONFIRMED=
SENDGRID_TEMPLATE_ORDER_STATUS_UPDATED=
SENDGRID_TEMPLATE_DOCUMENT_UPLOADED=

# ── Optional: File Storage (AWS S3) ───────────────────────────────────────────
# If left blank, files are stored locally (lost on Railway redeploy — use S3 for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
